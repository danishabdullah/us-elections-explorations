.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Rebuilt in seconds by `elections build` from data/raw and data/manual, both committed.
data/elections.sqlite
data/elections.sqlite-*
# Downloads stored under a hash of their URL are scratch; named source files in data/raw are committed.
data/raw/**/*.bin
data/raw/**/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# A global excludes file on this machine ignores /data/; this repo tracks it.
!/data/
!*.csv
# Dataverse guestbook answers (personal details); never committed.
guestbook.local.json
